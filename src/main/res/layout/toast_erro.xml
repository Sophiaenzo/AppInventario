<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="400dp"
    android:layout_height="match_parent"
    android:background="#970824"
    android:orientation="vertical">
    
        <ImageView
            android:id="@+id/ico_erro"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:src="@drawable/ic_erro_24"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#ffffff">
            
            <TextView
                android:id="@+id/texto_erro1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ERRO"
                android:textStyle="bold"
                android:textSize="30dp"
                android:gravity="center"
                android:layout_margin="5dp"
                android:textColor="#A6092D"/>

            <TextView
                android:id="@+id/texto_erro2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Menssagem de sucesso"
                android:textSize="18dp"
                android:gravity="center"
                android:layout_margin="5dp"
                android:textColor="#0E0D0D"/>

        </LinearLayout>

    <ImageView
        android:id="@+id/ico_erro1"
        android:layout_width="match_parent"
        android:layout_height="30dp"/>

</LinearLayout>